{
  "name": "moviemind",
  "private": true,
  "version": "1.0.0",
  "description": "MovieMind — Movie Recommendations and Trailers",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
