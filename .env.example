# ==============================================================================
# MovieMind AI — Production Environment Variables (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ── TMDB API (Movie Data & Metadata) ──────────────────────────────────────────
# Get a free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# ── Google Gemini API (Server-side LLM for AI Assistant & Script Studio) ─────
# Get a key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── MongoDB Atlas (Permanent Cloud Database) ─────────────────────────────────
# Get a free M0 cluster at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=moviemind

# ── Upstash Redis (Cross-Instance Real-time Messaging & Presence) ────────────
# Create a free Redis database at: https://upstash.com
# For Node.js / TLS connections, use the rediss:// URI format:
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── Better Auth Configuration ────────────────────────────────────────────────
# Generate a random 32+ character secret string (e.g. openssl rand -hex 32)
BETTER_AUTH_SECRET=your_32_character_random_secret_here
# Local: http://localhost:5001 or Production: https://your-domain.vercel.app
BETTER_AUTH_URL=http://localhost:5001
# Optional: Better Auth Infra API Key (https://better-auth.com)
BETTER_AUTH_API_KEY=your_better_auth_api_key_here

# ── Server Port (Local Dev) ──────────────────────────────────────────────────
PORT=5001
